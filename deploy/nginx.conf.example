# Salin ke /etc/nginx/sites-available/budaya-go lalu aktifkan:
#   sudo ln -s /etc/nginx/sites-available/budaya-go /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
# Setelah itu terbitkan sertifikat:
#   sudo certbot --nginx -d budaya.app.launchify.site

server {
    listen 80;
    listen [::]:80;
    server_name budaya.app.launchify.site;

    client_max_body_size 2m;

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
