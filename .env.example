# Salin menjadi .env lalu sesuaikan nilainya.

# Kredensial PostgreSQL (pakai karakter alfanumerik agar aman di DATABASE_URL)
POSTGRES_DB=ruang_budaya
POSTGRES_USER=ruang_budaya
POSTGRES_PASSWORD=ganti-password-kuat

# Origin browser yang diizinkan backend (alamat publik lewat nginx).
CORS_ORIGIN=https://budaya.app.launchify.sites

# Dipakai frontend saat build. Biarkan "/api" agar lewat reverse proxy (same-origin).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=https://budaya.app.launchify.sites
