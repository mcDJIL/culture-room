# Salin menjadi .env lalu sesuaikan nilainya.

# Kredensial PostgreSQL (pakai karakter alfanumerik agar aman di DATABASE_URL)
POSTGRES_DB=ruang_budaya
POSTGRES_USER=ruang_budaya
POSTGRES_PASSWORD=ganti-password-kuat

# Alamat publik yang dilayani Caddy.
# ":80" untuk akses lewat IP VPS, atau domain (mis. budaya.example.com) untuk HTTPS otomatis.
SITE_ADDRESS=:80

# Origin browser yang diizinkan backend. Harus sama dengan alamat publik di atas.
CORS_ORIGIN=http://IP_VPS_ANDA

# Dipakai frontend saat build. Biarkan "/api" agar lewat reverse proxy (same-origin).
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://IP_VPS_ANDA
